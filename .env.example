# Copy this file to .env and fill in your keys.
# .env is listed in .gitignore and will never be committed.

# Required for steps 1, 3, 4, and 5 (OpenAI evaluator)
OPENAI_API_KEY=sk-...

# Required for step 5 (Gemini evaluator variant)
GOOGLE_API_KEY=

# Required to download gated FLUX models from Hugging Face (step 6)
HF_TOKEN=hf_...

# Optional — override the default model used in step 1 / step 3 / step 4
# MODEL_NAME=gpt-4o
